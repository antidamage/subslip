# SubSlip settings. Copy to .env next to the binary (or pass --env FILE).
# Every value here is the default unless noted; delete a line to use it.
# Process environment variables override this file.

# --- Where things are -------------------------------------------------------

# The Subsonic server SubSlip sits in front of: the address your client used
# before SubSlip, including any base path. Octo usually listens on 5274,
# Navidrome on 4533 (add /navidrome or similar if you set a BaseUrl).
UPSTREAM_URL=http://127.0.0.1:4533

# Where SubSlip listens. Point your client here.
LISTEN_ADDR=0.0.0.0:5276

# Serve SubSlip under a path prefix, e.g. /music, when a reverse proxy routes
# a sub-path to it. Empty means the root.
BASE_PATH=

# SubSlip's own cache. Relative paths are resolved next to this file.
DB_PATH=./data/instant_mix_cache.db

# --- Kill switch --------------------------------------------------------------

# normal, or passthrough: a plain reverse proxy with no cache, no hooks and no
# outbound calls. Use it to rule SubSlip out while diagnosing something else.
SUBSLIP_MODE=normal

# --- Instant Mix cache ------------------------------------------------------

# A mix older than CACHE_REFRESH_HOURS is still served, and rebuilt in the
# background. A mix older than CACHE_TTL_HOURS is never served.
CACHE_TTL_HOURS=24
CACHE_REFRESH_HOURS=6

# The ListenBrainz supplement runs only when the upstream returns fewer than
# MIN_MIX_TRACKS. Mixes are capped at MAX_MIX_TRACKS.
MIN_MIX_TRACKS=15
MAX_MIX_TRACKS=25

# Pre-cache the mix of the song each user starts playing (true), or never
# (false). Each song played costs one Instant Mix call to your server in the
# background, after the delay below. v0.1's "auto" is read as true.
PRECACHE_ON_PLAY=true

# Wait this long after a song starts before pre-caching its mix, so skipping
# through tracks costs nothing.
FETCH_ON_PLAY_DELAY_SECONDS=10

# Minimum gap between two background builds for one user.
REMOTE_STATION_API_QUERY_RATE_LIMIT_SECONDS=10

# While a user's Instant Mix for one song is being fetched, or for this long
# after it started, a request for a different song is passed straight through.
MIX_RATE_LIMIT_SECONDS=10

# Deadline for one call to your server's Instant Mix, background builds and
# client requests alike. A client that gives up first does not cancel it: the
# answer is still stored, so the next request for that song is instant.
BACKGROUND_BUILD_TIMEOUT_SECONDS=90

# At most this many background builds run at once, across all users.
BACKGROUND_MAX_CONCURRENT=2

# When your server has not answered an Instant Mix after this many seconds,
# SubSlip answers with a short interim list (the song's artist and genre) so
# the client does not give up; the real mix is stored for the next request.
# Keep the two together under your client's timeout (30 s for some clients).
# 0 turns the interim off. Decimals are allowed.
MISS_WAIT_SECONDS=22
INTERIM_BUDGET_SECONDS=6

# When your server answers an Instant Mix with no tracks, ask once more this
# many seconds later (once per song per hour). Some servers (Octo, when its
# YouTube search fails) answer empty and have the full mix moments later.
# 0 turns it off.
EMPTY_RETRY_SECONDS=10

# --- ListenBrainz supplement ------------------------------------------------

# Public ListenBrainz endpoints; no account needed.
LISTENBRAINZ_ENABLED=true
LISTENBRAINZ_API_URL=https://api.listenbrainz.org
# search3 lookups per build, and the time limit for the whole supplement.
MAX_SEARCH_LOOKUPS=20
SUPPLEMENT_DEADLINE_SECONDS=20

# --- Security ---------------------------------------------------------------

# A cache hit never reaches the upstream, so SubSlip checks the caller's
# credentials with the upstream's ping first and remembers a success for
# AUTH_CACHE_TTL_SECONDS. Keep true if SubSlip is reachable from the internet.
# false is for a LAN or VPN where every client is trusted.
REQUIRE_AUTH=true
AUTH_CACHE_TTL_SECONDS=60

# Bearer token for /subslip/status. Empty disables status. Use a long random
# string; `subslip doctor` reads it from this file.
STATUS_TOKEN=

# --- Logging ----------------------------------------------------------------

# debug, info, warn or error; text or json. LOG_FILE also writes to a file.
# Credentials are redacted from every line.
LOG_LEVEL=info
LOG_FORMAT=text
LOG_FILE=
